
'use client';
import {useState, useEffect} from 'react';
import {PunctumBoard} from '../../../components/PunctumBoard';
import {JitsiRoom} from '../../../components/JitsiRoom';
import {SIGNAL_CARDS} from '../../../lib/cards';
function getCode(id:string){let h=0;for(let i=0;i<id.length;i++)h=(h*31+id.charCodeAt(i))%1000000;return (h+100000).toString().slice(-6);}
export default function Play({params}:{params:{sessionId:string}}){
  const [code,setCode]=useState(''); const [entered,setEntered]=useState(false); const [nick,setNick]=useState(''); const [sessionCode,setSessionCode]=useState(''); const [facData,setFacData]=useState<any>(null); const [myTokens,setMyTokens]=useState<any[]>([]); const [zone,setZone]=useState('JAUNE'); const [error,setError]=useState('');
  useEffect(()=>{setSessionCode(getCode(params.sessionId)); const iv=setInterval(async()=>{try{const r=await fetch(`/api/session/${params.sessionId}`); const d=await r.json(); if(!d.empty) setFacData(d);}catch{}},1000); return ()=>clearInterval(iv);},[params.sessionId]);
  useEffect(()=>{if(!entered) return; const iv=setInterval(async()=>{try{const r=await fetch(`/api/session/${params.sessionId}`); const d=await r.json(); const players=d.players||[]; const others=players.filter((p:any)=>p.nick!==nick); const me={nick, zone, tokens:myTokens, code}; await fetch(`/api/session/${params.sessionId}`,{method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({players:[...others, me]})});}catch{}},1500); return ()=>clearInterval(iv);},[entered, nick, zone, myTokens, code, params.sessionId]);
  const cardIdx=facData?.cardIdx||0; const card=SIGNAL_CARDS[cardIdx % SIGNAL_CARDS.length]; const revealed=facData?.revealed||'signal';
  if(!entered){ return (<main className="min-h-screen bg-[#FFFEF9] flex items-center justify-center p-6"><div className="w-full max-w-[360px] bg-white border rounded-[24px] p-8 shadow"><p className="text-[10px] uppercase">{params.sessionId}</p><h1 className="font-serif text-[24px] mt-2">Rejoindre session</h1><p className="text-[12px] opacity-60">Code 6 chiffres facilitateur • Synchro temps réel</p><input value={nick} onChange={e=>setNick(e.target.value)} placeholder="Prénom" className="mt-4 w-full border rounded-[12px] px-4 py-3" /><input value={code} onChange={e=>setCode(e.target.value.replace(/[^0-9]/g,'').slice(0,6))} placeholder="Code 6 chiffres" className="mt-3 w-full border rounded-[12px] px-4 py-3 font-mono tracking-widest" /><p className="text-[10px] opacity-50 mt-2">Code: {sessionCode}</p>{error&&<p className="text-[11px] text-red-600 bg-red-50 p-2 rounded mt-2">{error}</p>}<button onClick={()=>{if(code.length!==6){setError('6 chiffres');return;} if(code!==sessionCode){setError('Invalide attendu '+sessionCode);return;} if(!nick.trim()){setError('Prénom');return;} setEntered(true);}} className="mt-4 w-full bg-black text-white py-3 rounded-full">Entrer - Punctum complet</button></div></main>) }
  return (<main className="min-h-screen bg-[#FFFEF9] p-4"><header className="max-w-[640px] mx-auto flex justify-between"><p className="text-[11px]">Joueur {nick} • {params.sessionId} • Phase {revealed} • Code {code}</p><p className="text-[11px] bg-black text-white px-2 py-1 rounded-full">{myTokens.length} jetons</p></header><div className="max-w-[640px] mx-auto mt-4 space-y-4"><div className="bg-white border rounded-[16px] p-4"><p className="text-[10px] uppercase">{card.id} {card.famille} • {card.biais} • Théorique {card.positionPiege} • Piège {card.piege}</p><p className="font-serif text-[16px] mt-1">"{card.signal}"</p>{revealed!=='signal'&&<p className="text-[12px] mt-2 bg-[#FFFEF9] border p-2 rounded">Indice1: {card.indice1}</p>}{(revealed==='indice2'||revealed==='situation')&&<p className="text-[12px] mt-2 bg-black text-white p-2 rounded">Indice2: {card.indice2}</p>}</div><PunctumBoard tokens={[...(facData?.tokens||[]), ...myTokens]} selectedZone={zone} onSelect={setZone} onDrop={(z,s)=>setMyTokens([...myTokens,{zone:z,slot:s}])} /><JitsiRoom roomName={params.sessionId} /></div></main>)
}
